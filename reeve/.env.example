# Reeve — Environment Variables
# Copy this file to .env and fill in real values

# ── Phase 1: DM Agent (required) ──────────────────────────────────────────────
META_VERIFY_TOKEN=        # Webhook verification token — any string you choose; set same value in Facebook App dashboard
META_APP_SECRET=          # From Facebook App Settings → Basic → App Secret
META_PAGE_ACCESS_TOKEN=   # Instagram/Page access token (from Graph API Explorer, needs instagram_manage_messages permission)
INSTAGRAM_PAGE_ID=        # Your Instagram Business account's numeric Page ID
ANTHROPIC_API_KEY=        # From console.anthropic.com

# ── Phase 1: DM Agent (optional) ──────────────────────────────────────────────
DAVE_NOTIFY_EMAIL=        # Email Dave when a high-fit lead is routed (e.g. dave@reeve.agency)
CALL_BOOKING_LINK=        # cal.com link for booking a 20-min call with Dave (shown in high_fit message)
PORT=3000                 # Port the Express webhook server listens on (default 3000)

# ── Phase 2: Conference Scout (required to scout) ─────────────────────────────
SERPAPI_KEY=              # From serpapi.com — used by conference-scout.js to find open CFPs

# ── Phase 5: Reporter (required to send client digests) ───────────────────────
ZOHO_EMAIL=               # Sending email address (e.g. dave@reeve.agency)
ZOHO_APP_PASSWORD=        # Zoho app-specific password (not account password)
