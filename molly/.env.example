# Molly — Trevo Advisors content engine
# Copy to .env and fill in your values

# Required
ANTHROPIC_API_KEY=sk-ant-...

# Buffer — auto-posting to Instagram/LinkedIn
BUFFER_ACCESS_TOKEN=
BUFFER_INSTAGRAM_PROFILE_ID=   # optional: skip profile lookup on every run

# Instagram Analytics (for analyst.js)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# SerpApi — live research (researcher.js falls back to evergreen without this)
SERPAPI_KEY=

# Unsplash — editorial photo backgrounds (canvas-render.js falls back to gradients without this)
UNSPLASH_ACCESS_KEY=

# Posting schedule — default: TUE 7am, THU noon, SAT 9am, SUN 6pm (all Mountain Time)
POST_SCHEDULE=TUE:07:00,THU:12:00,SAT:09:00,SUN:18:00
TIMEZONE=America/Denver
