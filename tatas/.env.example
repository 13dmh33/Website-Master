# ── Tech 4 Tatas (tatas/) environment ──────────────────────────────────────
# Phase 1: carousel lane. Separate Instagram account from Miley/@techs4tatas —
# NEVER reuse Miley's INSTAGRAM_* credentials here. Same Meta app is fine.

# Claude API — carousel copywriting (writer.js). Blank → built-in fallback
# carousels only (zero spend, used for dry-runs).
ANTHROPIC_API_KEY=

# Model for writer.js. Defaults to claude-opus-4-8.
# TATAS_MODEL=claude-opus-4-8

# Review-first: keep set. writer.js always creates posts as 'pending'; nothing
# posts until approve-week.js flips them to 'approved'.
FORCE_QUEUE=1

# Instagram API — DIRECT POSTING + token refresh. Same Meta app as Miley,
# second Instagram account, its own token. GitHub Actions secrets use the
# same TATAS_ names.
TATAS_IG_TOKEN=
TATAS_IG_USER_ID=

# API flavor: default is "Instagram API with Instagram Login" (graph.instagram.com,
# NO Facebook Page link, 60-day tokens auto-refreshed by tatas-token-refresh).
# Set to 'facebook' only for the legacy FB-Page-linked setup.
# TATAS_IG_API_MODE=facebook

# Where hosted cards + the review preview are served from (the Netlify site
# publishing website/). Cards: {BASE}/social/tatas/{week}/ · review: {BASE}/review/tatas/
TATAS_SOCIAL_BASE_URL=https://trevoadvisors.com

# Brand handle stamped on rendered cards.
TATAS_IG_HANDLE=@tech4tatas
