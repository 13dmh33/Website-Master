# Missy — job-hunter environment.
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# Anything left blank simply disables the feature that needs it (the pipeline
# skips that source or step and tells you why), so you can start with a partial
# set of keys and add more later.

# --- Claude (required for scoring + tailoring) ---
ANTHROPIC_API_KEY=

# --- Adzuna (free tier: https://developer.adzuna.com/) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- USAJobs (free: https://developer.usajobs.gov/APIRequest). Optional/federal. ---
# USAJobs requires your registered email in the User-Agent header.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Email digest (Zoho SMTP via nodemailer) ---
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=
DIGEST_TO=dave@trevoadvisors.com
SIGNATURE_NAME=Dave Hettinger

# --- Google Sheet tracker (service account with edit access to the sheet) ---
# Path to the downloaded service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
SHEET_ID=

# --- Tunables (safe defaults shown) ---
MIN_SCORE=70
DAILY_LIMIT=8
MAX_AGE_DAYS=21
# INSTANT_ALERT_MIN off by default. Set to a number (e.g. 85) to fire a one-off
# email the moment a job scores at/above it AND was posted in the last 24h.
INSTANT_ALERT_MIN=
