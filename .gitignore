# Secrets
.env.local

# Dependencies
node_modules/

# Runtime data
# leads/*.json intentionally tracked so Diagnoser can run from container
messages/*.json
messages/*.txt
mockups/*.txt
# queue/*.json intentionally tracked so Pitcher can run on any machine

# Logs
logs/*.log

# Nora runtime data — customer end-customer conversations (PII), drafts, logs.
# Config in nora/config/customers/*.json is intentionally tracked (durable setup).
nora/logs/*.log
nora/state/conversations/**
nora/state/drafts/**
!nora/state/.gitkeep

# Generated reports (local output — not tracked)
reports/*.csv
reports/*.json

# Midas — personal stock screener, not a Trevo Advisors system (see midas/CLAUDE.md)
midas/reports/*.csv
midas/reports/*.json
midas/reports/*.md
midas/reports/*.txt

# OS
.DS_Store
AllContacts.csv
SentLog.csv

# Local safety backups of live state files (created before pipeline runs)
.backups/
