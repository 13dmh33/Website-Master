# ── Tech 4 Tatas (tatas/) environment ──────────────────────────────────────
# Phase 1: carousel lane. Separate Instagram account from Miley/@techs4tatas —
# NEVER reuse Miley's INSTAGRAM_* credentials here. Same Meta app is fine.

# Claude API — carousel copywriting (writer.js). Blank → built-in fallback
# carousels only (zero spend, used for dry-runs).
ANTHROPIC_API_KEY=

# Model for writer.js. Defaults to claude-opus-4-8.
# TATAS_MODEL=claude-opus-4-8

# Review-first: keep set. writer.js always creates posts as 'pending'; nothing
# posts until approve-week.js flips them to 'approved'.
FORCE_QUEUE=1

# Instagram API — DIRECT POSTING + token refresh. Same Meta app as Miley,
# second Instagram account, its own token. GitHub Actions secrets use the
# same TATAS_ names.
TATAS_IG_TOKEN=
TATAS_IG_USER_ID=

# API flavor: default is "Instagram API with Instagram Login" (graph.instagram.com,
# NO Facebook Page link, 60-day tokens auto-refreshed by tatas-token-refresh).
# Set to 'facebook' only for the legacy FB-Page-linked setup.
# TATAS_IG_API_MODE=facebook

# Where hosted cards + the review preview are served from (the Netlify site
# publishing website/). Cards: {BASE}/social/tatas/{week}/ · review: {BASE}/review/tatas/
TATAS_SOCIAL_BASE_URL=https://trevoadvisors.com

# Brand handle stamped on rendered cards.
TATAS_IG_HANDLE=@tech4tatas

# ── Phase 2: Reels + voiceover lane ─────────────────────────────────────────
# ElevenLabs text-to-speech for reel voiceovers (voicer.js). Blank → voicer
# skips (or use --no-vo for captions-only reels). Get a key at elevenlabs.io;
# pick a CONVERSATIONAL voice ID from your library (not a broadcast narrator).
# Run `node voicer.js --sample` once to preview the voice cheaply before voicing
# full scripts.
TATAS_ELEVENLABS_KEY=
TATAS_ELEVENLABS_VOICE_ID=
# Voice tuning (optional). Defaults chosen to sound human, not narrator:
# eleven_turbo_v2_5 is natural + ~half the character cost; eleven_v3 is the most
# expressive. Lower stability = more natural variation.
# TATAS_ELEVENLABS_MODEL=eleven_turbo_v2_5
# TATAS_ELEVENLABS_STABILITY=0.35
# TATAS_ELEVENLABS_STYLE=0.35

# Pexels API key (free) → briefer.js resolves real b-roll clip candidates per
# beat. Blank → the brief still includes ready-to-click Pexels search links.
TATAS_PEXELS_KEY=

# Phase 2b (OPTIONAL, OFF by default): Shotstack template render → base MP4
# with burned-in captions (render.js). Leave blank to keep the reels lane
# ending at the CapCut brief bundle, which is the Phase 2 deliverable.
TATAS_SHOTSTACK_KEY=
