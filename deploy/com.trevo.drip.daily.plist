<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drip daily run — launchd job. Sends the next scheduled follow-up (d1/d1b/d1c/d2)
  to non-responders, EMAIL channel only (SMS is A2P-blocked). Local + private,
  runs on the Mac (Zoho SMTP is blocked from the container).

  Gates already enforced by drip.js on every send: CAN-SPAM footer + address +
  opt-out, contact-keyed do-not-contact suppression, and reply/opt-out exit.
  daily_limit is 20/day (config/drip-config.json).

  Before loading, replace:
    <NODE_PATH> -> `which node`   (e.g. /opt/homebrew/bin/node)
    <REPO_PATH> -> /Users/davidhettinger/Website-Master
  See DRIP-TURN-ON.md for the verify-then-enable steps. Do a --dry-run first.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.trevo.drip.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string><NODE_PATH></string>
        <string><REPO_PATH>/scripts/drip.js</string>
        <string>--force</string>
        <string>--channel</string>
        <string>email</string>
    </array>

    <key>WorkingDirectory</key>
    <string><REPO_PATH></string>

    <!-- 9:00 AM daily — after the 8am pitcher send, so a same-day initial + drip don't collide. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string><REPO_PATH>/logs/drip-daily.log</string>
    <key>StandardErrorPath</key>
    <string><REPO_PATH>/logs/drip-daily.err.log</string>
</dict>
</plist>
