<?xml version="1.0" encoding="UTF-8"?>
<!--
  Missy daily run — launchd job. Runs the job-hunt pipeline once every morning
  and emails you the digest. Local + private (never GitHub Actions).

  Before loading, replace the two PATH placeholders below:
    1. __NODE_PATH__   -> output of `which node`   (e.g. /opt/homebrew/bin/node)
    2. __MISSY_PATH__  -> Missy's permanent home    (e.g. /Users/davidhettinger/missy/job-hunter)
  See TURN-ON.md for the full one-time setup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dave.missy.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>/Users/davidhettinger/missy/job-hunter/src/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/davidhettinger/missy/job-hunter</string>

    <!-- 4:45 AM every day, per Dave's request. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/davidhettinger/missy/job-hunter/logs/missy-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/davidhettinger/missy/job-hunter/logs/missy-daily.err.log</string>
</dict>
</plist>
