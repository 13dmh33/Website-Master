# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.
#
# Setup order:
#   1. ANTHROPIC_API_KEY  — needed for Diagnoser + Checker (Day 1)
#   2. OUTSCRAPER_API_KEY — needed for Scout (Day 1)
#   3. RESEND_API_KEY     — needed for Pitcher email sends (Day 4)
#   4. TWILIO_*           — needed for Pitcher SMS sends (Day 4)
#   5. CALCOM_LINK        — optional, shown in Mobile booking drafts

# Outscraper — outscraper.com/profile
OUTSCRAPER_API_KEY=

# Anthropic — console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Resend — resend.com/api-keys
RESEND_API_KEY=

# Pitcher sender identity (shown in From: header)
FROM_EMAIL=outreach@yourdomain.com
FROM_NAME=Your Name

# Twilio — console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Your email for deal/reply notifications (not used yet)
CONTRACTOR_EMAIL=

# Zoho SMTP — for Pitcher email sends and Reporter
ZOHO_EMAIL=
ZOHO_APP_PASSWORD=

# Where the morning report is sent (defaults to ZOHO_EMAIL if not set)
REPORT_TO_EMAIL=

# Cal.com booking link (optional) — shown in Mobile reply drafts
# Get from cal.com/your-username/15min
CALCOM_LINK=
