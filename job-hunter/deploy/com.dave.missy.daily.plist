<?xml version="1.0" encoding="UTF-8"?>
<!--
  Missy daily run — launchd job. Runs the job-hunt pipeline once every morning
  and emails you the digest. Local + private (never GitHub Actions).

  Before loading, replace the two PATH placeholders below:
    1. __NODE_PATH__   -> output of `which node`   (e.g. /opt/homebrew/bin/node)
    2. __MISSY_PATH__  -> Missy's permanent home    (e.g. /Users/davidhettinger/missy/job-hunter)
  See TURN-ON.md for the full one-time setup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dave.missy.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__NODE_PATH__</string>
        <string>__MISSY_PATH__/src/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__MISSY_PATH__</string>

    <!-- 6:00 AM every day. Adjust Hour/Minute to taste (digest lands before your 5-8am block if you drop it to 4:45). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__MISSY_PATH__/logs/missy-daily.log</string>
    <key>StandardErrorPath</key>
    <string>__MISSY_PATH__/logs/missy-daily.err.log</string>
</dict>
</plist>
