# Copy this file to .env.local and fill in your keys.
# .env.local is gitignored — never commit real keys.

# Required — Outscraper API (get from outscraper.com/profile)
OUTSCRAPER_API_KEY=

# Required — Anthropic API (get from console.anthropic.com)
ANTHROPIC_API_KEY=

# Required — email sending for Pitcher (resend.com or sendgrid.com)
RESEND_API_KEY=

# Optional — SMS for Pitcher (reuse from Nora if already set up)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Required — where deal/reply notifications go
CONTRACTOR_EMAIL=
