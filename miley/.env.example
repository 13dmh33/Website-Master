# ── Miley (Techs4Tatas) environment ───────────────────────────────────────

# Claude API — content generation. If blank, the pipeline uses evergreen.json
# content (zero spend). Get at console.anthropic.com.
ANTHROPIC_API_KEY=

# Review-first: keep this set to 1 so nothing auto-posts. Every run writes to
# output/queue/ + builds a preview; you approve with scripts/push-queue.js.
FORCE_QUEUE=1

# Buffer — auto-posting (run the push-queue/approval step where Buffer is reachable).
# MUST be a CLASSIC access token from buffer.com/developers (NOT the MCP/OIDC token — it 401s).
BUFFER_ACCESS_TOKEN=
BUFFER_INSTAGRAM_PROFILE_ID=

# Instagram Graph API — read-only analytics only (Analyst). Optional.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Operator config
TIMEZONE=America/Denver
INSTAGRAM_HANDLE=@techs4tatas
STOREFRONT_URL=techs4tatas.printify.me
DM_KEYWORD=PINK

# ── Sales funnel: link-in-bio hub + attribution ───────────────────────────
# Host the linkpage/ folder on any free static host (Netlify / GitHub Pages /
# Cloudflare Pages), then put that URL here AND in your Instagram bio.
# Until set, links fall back to the storefront directly.
LINKPAGE_URL=
# Free analytics on the linkpage so clicks are attributable (create either/both):
GA_MEASUREMENT_ID=        # GA4, e.g. G-XXXXXXX
META_PIXEL_ID=            # Meta Pixel id (also powers retargeting warm IG traffic)
# Email capture form endpoint on the linkpage (Formspree / Buttondown free tier):
EMAIL_CAPTURE_ACTION=

# Force evergreen content even when a Claude key is present (testing). Optional.
# FORCE_EVERGREEN=1

# Live data refresh: the Researcher pulls fresh, on-brand RSS headlines (free,
# no key — women-in-trades + breast-cancer beats) and feeds them to the Generator
# as paraphrasable angles. Fails silently offline. Set to 1 to skip it entirely.
# DISABLE_LIVE_RESEARCH=1

# ── Visual templates (#11) ─────────────────────────────────────────────────
# New card layouts (renderCleanCard, renderPhotoCard) exist in lib/canvas-render.js
# but stay OFF by default — set to 'true' once Printify product mockups are in
# assets/products/ and you want variety beyond the original gradient cards.
# TEMPLATES_ACTIVE=true
# Emergency bypass for the visual quality gate (render-validate.js). Logs loudly
# every run when set — do not leave this on.
# SKIP_VISUAL_GATE=true
