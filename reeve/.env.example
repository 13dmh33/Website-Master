# Reeve DM Agent — Environment Variables
# Copy this file to .env and fill in real values

# Meta / Instagram
META_VERIFY_TOKEN=        # Webhook verification token you set in the Meta App Dashboard (any string you choose)
META_APP_SECRET=          # From Facebook App Settings → Basic → App Secret
META_PAGE_ACCESS_TOKEN=   # Instagram/Page access token (from Graph API Explorer or System User)
INSTAGRAM_PAGE_ID=        # Your Instagram Business account's numeric Page ID

# Anthropic
ANTHROPIC_API_KEY=        # From console.anthropic.com

# Routing
DAVE_NOTIFY_EMAIL=        # Optional — email Dave when a high-fit lead is routed (e.g. dave@reeve.agency)
CALL_BOOKING_LINK=        # cal.com link for booking a 20-min call with Dave

# Server
PORT=3000                 # Port the Express webhook server listens on (default 3000)
