# Claude API — required for all content generation
ANTHROPIC_API_KEY=

# PostPeer — required for auto-posting. Get at postpeer.dev
# Leave blank to use queue fallback (manual posting via node scripts/push-queue.js)
POSTPEER_API_KEY=
POSTPEER_ACCOUNT_ID=

# Instagram Graph API — read-only analytics only, not used for posting
# Get from Meta Developer dashboard (requires Instagram Business account)
# Leave blank to skip analytics at launch
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Operator config
TIMEZONE=America/Denver
POST_SCHEDULE=TUE:07:00,THU:12:00,SAT:09:00,SUN:18:00
WEEKLY_POST_COUNT=4
INSTAGRAM_HANDLE=@reeve.agency

# Content niche rotation (all three active at launch)
CONTENT_NICHES=automation,booking,mindset

# Optional: SerpApi for live research (free tier available at serpapi.com)
# Leave blank to use evergreen fallback always
SERPAPI_KEY=
