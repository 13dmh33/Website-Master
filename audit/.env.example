# Trevo site-audit agent — environment variables
# Copy to .env and fill in real values. Never commit .env with real keys.

# Google PageSpeed Insights API key — used for load speed / Core Web Vitals / mobile-friendliness checks
PAGESPEED_API_KEY=

# Anthropic API key — used for the vision pass (screenshot critique) and copy generation
ANTHROPIC_API_KEY=

# Name to sign cold outreach with. Never hardcode a person's name in templates — always read it from here.
TREVO_SIGNATURE_NAME=

# Optional: model override for the vision/copy pass. Defaults to claude-sonnet-4-6.
# Use claude-haiku-4-5 as a cheaper fallback if per-lead cost becomes a concern at higher volume.
ANTHROPIC_MODEL=claude-sonnet-4-6
